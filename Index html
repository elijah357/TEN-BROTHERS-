        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs sm:text-sm text-slate-300 font-medium">
          <span class="bg-slate-950/80 px-3 py-1 rounded-lg border border-slate-800">
            Paybill: <strong class="text-amber-400 font-mono font-bold text-base">522533</strong>
          </span>
          <span class="bg-slate-950/80 px-3 py-1 rounded-lg border border-slate-800">
            Account No: <strong class="text-amber-400 font-mono font-bold text-base">8112488</strong>
          </span>
          <span class="bg-slate-950/80 px-3 py-1 rounded-lg border border-slate-800">
