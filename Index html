      </div>

      <div class="space-y-3">
        <div>
          <label class="text-xs font-bold text-slate-400 block mb-1">M-PESA Phone Number</label>
          <input type="tel" id="stkPhone" placeholder="0700000000" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white font-mono text-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition">
        </div>
        <div>
          <label class="text-xs font-bold text-slate-400 block mb-1">Payment Amount (KSh)</label>
          <input type="number" id="stkAmount" value="500" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white font-mono text-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition">
        </div>
      </div>

      <div class="flex gap-3 pt-2">
        <button onclick="closeStkModal()" class="flex-1 bg-slate-800 hover:bg-slate-700 py-3 rounded-xl font-bold text-slate-300 text-xs">Cancel</button>
        <button onclick="sendStkPush()" class="flex-1 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black py-3 rounded-xl text-xs uppercase tracking-wider shadow-lg shadow-emerald-500/20">Send Prompt</button>
      </div>
    </div>
  </div>

  <!-- 2. Receipt Delivery Modal -->
  <div id="receiptModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 space-y-5 shadow-2xl relative">
      <button onclick="closeReceiptModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>

      <div class="flex items-center space-x-3 border-b border-slate-800 pb-3">
        <div class="bg-blue-600/20 text-blue-400 p-3 rounded-xl text-xl border border-blue-500/30">
          <i class="fa-solid fa-receipt"></i>
        </div>
        <div>
          <h3 class="text-lg font-extrabold text-white">Generate Individual Receipt</h3>
          <p class="text-xs text-slate-400">Dispatch formatted payment message via WhatsApp or SMS</p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 text-xs">
        <div>
          <label class="text-slate-400 font-bold block mb-1">Amount Paid (KSh)</label>
          <input type="number" id="rcptPaidAmount" value="500" oninput="previewReceiptText()" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-white font-mono outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="text-slate-400 font-bold block mb-1">Payment Category</label>
          <select id="rcptCategory" onchange="previewReceiptText()" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-white outline-none focus:border-blue-500">
            <option value="Monthly Contribution">Monthly Contribution</option>
            <option value="Fine Penalty Payment">Fine Penalty Payment</option>
          </select>
        </div>
      </div>

      <div>
        <label class="text-xs font-bold text-slate-400 block mb-1">Formatted Message Preview</label>
        <textarea id="rcptPreviewText" rows="8" readonly class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-slate-200 font-mono text-xs focus:outline-none leading-relaxed"></textarea>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 pt-1">
        <button onclick="copyReceiptText()" class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-200 py-3 rounded-xl font-bold text-xs flex items-center justify-center gap-2">
          <i class="fa-solid fa-copy"></i>
          <span>Copy SMS Text</span>
        </button>
        <button onclick="openWhatsAppReceipt()" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white py-3 rounded-xl font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30">
          <i class="fa-brands fa-whatsapp text-base"></i>
          <span>Send via WhatsApp</span>
        </button>
      </div>
    </div>
  </div>

  <!-- JavaScript Logic -->
  <script>
    // Initial Preloaded 10-Member Baseline Roster (Sept 15 Baseline Data)
    const defaultMembers = [
      { id: '1', name: 'Moses ries', amount: 4000, fine: 40, phone: '0700000001', status: 'APPROVED', username: 'moses', role: 'MEMBER', lastPaymentDate: '2026-09-15 10:30 AM' },
