      { id: '3', name: 'Wifred saruni', amount: 4000, fine: 0, phone: '0700000003', status: 'APPROVED', username: 'wifred', role: 'MEMBER', lastPaymentDate: '2026-09-15 02:45 PM' },
      { id: '4', name: 'Gideon tuukuo', amount: 2060, fine: 300, phone: '0700000004', status: 'APPROVED', username: 'gideon', role: 'MEMBER', lastPaymentDate: '2026-09-14 09:00 AM' },
      { id: '5', name: 'John shapapaa', amount: 1700, fine: 360, phone: '0700000005', status: 'APPROVED', username: 'john', role: 'MEMBER', lastPaymentDate: '2026-09-12 04:20 PM' },
      { id: '6', name: 'Emmanuel siara', amount: 2500, fine: 240, phone: '0700000006', status: 'APPROVED', username: 'emmanuel1', role: 'MEMBER', lastPaymentDate: '2026-09-10 01:10 PM' },
      { id: '7', name: 'Emmanuel tuukuo', amount: 1200, fine: 440, phone: '0700000007', status: 'APPROVED', username: 'emmanuel2', role: 'MEMBER', lastPaymentDate: '2026-09-08 10:05 AM' },
      { id: '8', name: 'Saitah siara', amount: 4000, fine: 0, phone: '0700000008', status: 'APPROVED', username: 'saitah', role: 'MEMBER', lastPaymentDate: '2026-09-15 08:30 AM' },
      { id: '9', name: 'Joel sironet', amount: 1700, fine: 360, phone: '0700000009', status: 'APPROVED', username: 'joel', role: 'MEMBER', lastPaymentDate: '2026-09-05 03:00 PM' },
      { id: '10', name: 'Jeremiah koilel', amount: 1300, fine: 420, phone: '0700000010', status: 'APPROVED', username: 'jeremiah', role: 'MEMBER', lastPaymentDate: '2026-09-01 11:00 AM' }
    ];

    // State Initialization
    let members = JSON.parse(localStorage.getItem('tb_members')) || defaultMembers;
    let bankBalance = JSON.parse(localStorage.getItem('tb_bank_balance')) || 24260;
    let currentUser = JSON.parse(localStorage.getItem('tb_current_user')) || { id: 'admin', name: 'Super Admin', role: 'ADMIN', status: 'APPROVED', username: 'admin' };
    let currentTab = 'DASHBOARD'; // DASHBOARD, ADMIN_PANEL, PROFILE, REGISTER
    let activeReceiptMember = null;

    // Save State
    function saveState() {
      localStorage.setItem('tb_members', JSON.stringify(members));
      localStorage.setItem('tb_bank_balance', JSON.stringify(bankBalance));
      localStorage.setItem('tb_current_user', JSON.stringify(currentUser));
    }

    // Render Navigation
    function renderNav() {
      const nav = document.getElementById('navControls');
      if (!currentUser) {
        nav.innerHTML = `
          <button onclick="setTab('LOGIN')" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-blue-600 text-white hover:bg-blue-500 shadow-md transition">Sign In</button>
          <button onclick="setTab('REGISTER')" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 transition">Register</button>
        `;
        return;
      }

      nav.innerHTML = `
        <button onclick="setTab('DASHBOARD')" class="px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 ${currentTab === 'DASHBOARD' ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/30' : 'bg-slate-800 text-slate-300 hover:bg-slate-700'}">
          <i class="fa-solid fa-chart-pie"></i> <span class="hidden sm:inline">Dashboard</span>
        </button>
        ${currentUser.role === 'ADMIN' ? `
          <button onclick="setTab('ADMIN_PANEL')" class="px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 ${currentTab === 'ADMIN_PANEL' ? 'bg-amber-600 text-white shadow-lg shadow-amber-600/30' : 'bg-slate-800 text-slate-300 hover:bg-slate-700'}">
            <i class="fa-solid fa-user-shield"></i> <span class="hidden sm:inline">Admin Panel</span>
            ${getPendingCount() > 0 ? `<span class="bg-red-500 text-white text-[10px] px-1.5 py-0.2 rounded-full font-black">${getPendingCount()}</span>` : ''}
          </button>
        ` : ''}
        <button onclick="setTab('PROFILE')" class="px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 ${currentTab === 'PROFILE' ? 'bg-blue-600 text-white' : 'bg-slate-800 text-slate-300 hover:bg-slate-700'}">
          <i class="fa-solid fa-user-pen"></i> <span class="hidden sm:inline">Profile</span>
        </button>
        <button onclick="logout()" title="Sign Out" class="px-3 py-1.5 sm:py-2 rounded-xl text-xs font-bold bg-red-500/20 text-red-400 border border-red-500/30 hover:bg-red-500/30 transition">
          <i class="fa-solid fa-right-from-bracket"></i>
        </button>
      `;
    }

    function getPendingCount() {
      return members.filter(m => m.status === 'PENDING').length;
    }

    function setTab(tab) {
      currentTab = tab;
      renderApp();
    }

    // Master Render Function
    function renderApp() {
      renderNav();
      const container = document.getElementById('appView');

      if (!currentUser && currentTab !== 'REGISTER') {
        container.innerHTML = renderAuthScreen();
        return;
      }

      if (currentTab === 'REGISTER') {
        container.innerHTML = renderRegisterScreen();
        return;
      }

      if (currentUser && currentUser.status === 'PENDING') {
        container.innerHTML = renderPendingScreen();
        return;
      }

      if (currentTab === 'PROFILE') {
        container.innerHTML = renderProfileScreen();
        return;
      }

      if (currentTab === 'ADMIN_PANEL' && currentUser.role === 'ADMIN') {
        container.innerHTML = renderAdminPanelScreen();
        return;
      }

      container.innerHTML = renderDashboardScreen();
    }

    // Login View
    function renderAuthScreen() {
      return `
        <div class="max-w-md mx-auto bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
          <div class="text-center space-y-2">
