              <i class="fa-solid fa-lock"></i>
            </div>
            <h2 class="text-2xl font-extrabold text-white">Member Sign In</h2>
            <p class="text-xs text-slate-400">Enter your Chama username and password to log in.</p>
          </div>

          <form onsubmit="handleLogin(event)" class="space-y-4">
            <div>
              <label class="text-xs font-bold text-slate-400 block mb-1">Username</label>
              <input type="text" id="loginUser" placeholder="e.g. moses or admin" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white focus:border-blue-500 outline-none transition text-sm">
            </div>
            <div>
              <label class="text-xs font-bold text-slate-400 block mb-1">Password</label>
              <input type="password" id="loginPass" placeholder="••••••••" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white focus:border-blue-500 outline-none transition text-sm">
            </div>
            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-extrabold py-3.5 rounded-xl shadow-lg transition text-sm uppercase tracking-wider">
              Sign In
            </button>
          </form>

          <div class="text-center pt-2 border-t border-slate-800 text-xs text-slate-400">
            Don't have an account? <button onclick="setTab('REGISTER')" class="text-blue-400 font-bold hover:underline">Register New Account</button>
          </div>
        </div>
      `;
    }

    // Register View
    function renderRegisterScreen() {
      return `
        <div class="max-w-md mx-auto bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
          <div class="text-center space-y-2">
            <div class="bg-emerald-600/20 text-emerald-400 w-14 h-14 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold border border-emerald-500/30">
              <i class="fa-solid fa-user-plus"></i>
            </div>
            <h2 class="text-2xl font-extrabold text-white">New Member Registration</h2>
            <p class="text-xs text-slate-400">Register to request access to the TEN BROTHERS portal.</p>
          </div>

          <form onsubmit="handleRegister(event)" class="space-y-4">
            <div>
              <label class="text-xs font-bold text-slate-400 block mb-1">Full Member Name</label>
              <input type="text" id="regName" placeholder="e.g. Daniel Lekutit" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white focus:border-emerald-500 outline-none text-sm">
            </div>
            <div>
              <label class="text-xs font-bold text-slate-400 block mb-1">Phone Number (M-PESA)</label>
              <input type="tel" id="regPhone" placeholder="0712345678" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white font-mono focus:border-emerald-500 outline-none text-sm">
            </div>
            <div>
              <label class="text-xs font-bold text-slate-400 block mb-1">Username</label>
              <input type="text" id="regUsername" placeholder="e.g. daniel" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white focus:border-emerald-500 outline-none text-sm">
            </div>
            <div>
              <label class="text-xs font-bold text-slate-400 block mb-1">Password</label>
              <input type="password" id="regPass" placeholder="••••••••" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white focus:border-emerald-500 outline-none text-sm">
            </div>
            <button type="submit" class="
